### --- Required ---
JWT_SECRET=secret

DATABASE_USER=kotatsu
DATABASE_PASSWORD=your_password

### --- Optional ---
#BASE_URL=http://localhost:8080
#ALLOW_NEW_REGISTER=true
#PORT=8080
#MAIL_PROVIDER=console

#DATABASE_PORT=3306
#DATABASE_HOST=localhost
#DATABASE_DIALECT=mariadb # or mysql
#DATABASE_NAME=kotatsu_db
#DATABASE_ROOT_PASSWORD=root-password

### --- Optional: SMTP (required if MAIL_PROVIDER=smtp) ---
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=example@example.com
#SMTP_PASSWORD=secret
#SMTP_FROM=Kotatsu <no-reply@example.com>

### --- Optional: Docker compose ---
# External port of the syncserver service
#SERVER_PORT=8080

# Where the database files are stored locally. By default, "kotatsu-db" volume
#DATABASE_DATA_PATH=kotatsu-db

# Persistent local cover blobs and cache (Docker named volume by default).
#COVERS_DATA_PATH=kotatsu-covers
# Public browser-reachable HTTPS URL, optionally including a reverse-proxy prefix.
# Defaults to BASE_URL. POST sync responses keep original device URLs.
#COVERS_PUBLIC_BASE_URL=https://sync.example.com
# Optional JSON allowlist: exact image host -> Referer. Redirects are not followed.
#COVER_REFERERS={"cover.cdnlibs.org":"https://mangalib.org/","cover.imglib.info":"https://mangalib.org/"}
